[Unit]
Description=Text-to-SQL API (main.py)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/Desktop/ML-Projects/DB_SQL_GEN
ExecStart=/root/Desktop/ML-Projects/DB_SQL_GEN/.venv/bin/python main.py
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
